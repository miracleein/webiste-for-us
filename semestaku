  function renderLightbox(){
    var m = currentMemory();
    if (!m) { closeOverlay('lbOverlay'); return; }
    if (lbSlideIdx >= m.slides.length) lbSlideIdx = 0;
    var slide = m.slides[lbSlideIdx];

    document.getElementById('lbCap').textContent = m.caption || 'tanpa catatan';
    document.getElementById('lbDate').textContent = fmtDate(m.date);
    document.getElementById('lbMood').textContent = moodOf(m.mood).em+' '+moodOf(m.mood).label;
    document.getElementById('lbSlidePos').textContent = m.slides.length>1 ? ('slide '+(lbSlideIdx+1)+'/'+m.slides.length) : '';

    var heart = document.getElementById('lbHeart');
    heart.textContent = m.favorite ? '♥' : '♡';
    heart.classList.toggle('on', !!m.favorite);
    heart.onclick = function(){
      m.favorite = !m.favorite;
      heart.textContent = m.favorite ? '♥' : '♡';
      heart.classList.toggle('on', m.favorite);
      saveIndex().then(renderAll);
    };
    document.getElementById('lbDelete').onclick = function(){ pendingDelete = {type:'memory', id:m.id}; openOverlay('confirmOverlay'); };
    document.getElementById('lbEdit').onclick = function(){ closeOverlay('lbOverlay'); openAddModal(m); };

    var prevSlideBtn = document.getElementById('lbSlidePrev');
    var nextSlideBtn = document.getElementById('lbSlideNext');
    var showSlideNav = m.slides.length > 1;
    prevSlideBtn.style.display = showSlideNav ? 'flex' : 'none';
    nextSlideBtn.style.display = showSlideNav ? 'flex' : 'none';

    var dots = document.getElementById('lbDots');
    dots.innerHTML = showSlideNav ? m.slides.map(function(s,i){ return '<button class="lb-dot '+(i===lbSlideIdx?'active':'')+'" data-i="'+i+'"></button>'; }).join('') : '';
    Array.prototype.forEach.call(dots.querySelectorAll('.lb-dot'), function(dot){
      dot.addEventListener('click', function(){ lbSlideIdx = parseInt(dot.getAttribute('data-i'),10); renderLightbox(); });
    });

    document.getElementById('lbMemPrev').disabled = lbList.length<2;
    document.getElementById('lbMemNext').disabled = lbList.length<2;

    var box = document.getElementById('lbMediaBox');
    var mediaSlot = box.querySelector('.media-slot');
    if (mediaSlot) mediaSlot.remove();
    var slot = document.createElement('div');
    slot.className = 'media-slot';
    slot.style.cssText = 'width:100%;display:flex;align-items:center;justify-content:center;';
    slot.innerHTML = '<div style="color:#c6bcd6;padding:40px;font-size:13px;">Memuat…</div>';
    box.appendChild(slot);

    getSlideFull(m.id, slide.uid).then(function(obj){
      if (m !== currentMemory() || slide !== m.slides[lbSlideIdx]) return;
      if (!obj){
        slot.innerHTML = '<img src="'+slide.thumb+'" style="max-height:64vh;max-width:100%;" alt="">'+
          '<div style="position:absolute;bottom:6px;left:0;right:0;text-align:center;color:#c6bcd6;font-size:11px;">pratinjau saja — berkas asli terlalu besar untuk disimpan</div>';
      } else if (obj.type==='video'){
        slot.innerHTML = '<video src="'+obj.dataUrl+'" controls autoplay muted playsinline></video>';
      } else {
        slot.innerHTML = '<img src="'+obj.dataUrl+'" alt="">';
      }
    });
  }
