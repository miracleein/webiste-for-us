      });
    });
    if (!selected && grid.firstElementChild) grid.firstElementChild.classList.add('sel');
  }
  function openAddModal(existing){
    resetAddModal();
    if (existing){
      editingId = existing.id;
      document.getElementById('addTitle').textContent = 'Ubah kenangan';
      document.getElementById('capInput').value = existing.caption || '';
      document.getElementById('dateInput').value = existing.date;
      renderMoodGrid(existing.mood);
      pendingSlides = existing.slides.map(function(s){ return { uid:s.uid, type:s.type, thumb:s.thumb, dataUrl:null, isNew:false, processing:false }; });
      renderSlideGrid();
    }
    openOverlay('addOverlay');
  }
  document.getElementById('btnOpenAdd').addEventListener('click', function(){ openAddModal(); });
  document.getElementById('dropzone').addEventListener('click', function(){ document.getElementById('fileInput').click(); });
  document.getElementById('fileInput').addEventListener('change', function(e){ if (e.target.files.length) addFilesToPending(e.target.files); });
  var dz = document.getElementById('dropzone');
  ['dragover','dragenter'].forEach(function(ev){ dz.addEventListener(ev, function(e){ e.preventDefault(); dz.classList.add('drag'); }); });
  ['dragleave','drop'].forEach(function(ev){ dz.addEventListener(ev, function(e){ e.preventDefault(); dz.classList.remove('drag'); }); });
  dz.addEventListener('drop', function(e){ if (e.dataTransfer.files.length) addFilesToPending(e.dataTransfer.files); });

  document.getElementById('btnSaveMemory').addEventListener('click', function(){
    var caption = document.getElementById('capInput').value.trim();
    var date = document.getElementById('dateInput').value || new Date().toISOString().slice(0,10);
    var moodSel = document.querySelector('.mood-opt.sel');
    var mood = moodSel ? moodSel.getAttribute('data-mood') : MOODS[0].id;

    if (pendingSlides.some(function(s){return s.processing;})){ toast('Tunggu sebentar, media masih diproses.'); return; }
    if (!pendingSlides.length){ toast('Pilih minimal satu foto atau video.'); return; }

    var id = editingId || uid();
    var oldFav = editingId ? ((index.find(function(x){return x.id===editingId;})||{}).favorite||false) : false;
    var oldCreated = editingId ? ((index.find(function(x){return x.id===editingId;})||{}).createdAt||Date.now()) : Date.now();

    var btn = document.getElementById('btnSaveMemory');
    btn.disabled = true; btn.textContent = 'Menyimpan…';

    var newSlides = pendingSlides.filter(function(s){return s.isNew;});
    var savePromises = newSlides.map(function(s){
      return saveSlideFull(id, s.uid, {type:s.type, dataUrl:s.dataUrl}).then(function(res){
        fullCache[id+':'+s.uid] = {type:s.type, dataUrl:s.dataUrl};
        return { uid:s.uid, ok:res.ok, tooLarge:res.tooLarge };
      });
    });
    var cleanupPromises = removedUids.map(function(u){ return deleteSlideFull(id, u); });

    Promise.all(savePromises.concat(cleanupPromises)).then(function(results){
      var anyTooLarge = results.some(function(r){ return r && r.tooLarge; });
      var slidesMeta = pendingSlides.map(function(s){ return { uid:s.uid, type:s.type, thumb:s.thumb }; });
      var entry = { id:id, caption:caption, date:date, mood:mood, favorite:oldFav, createdAt:oldCreated, slides:slidesMeta };
      var idx = index.findIndex(function(x){return x.id===id;});
      if (idx>-1) index[idx] = entry; else index.unshift(entry);
      return saveIndex().then(function(){
        closeOverlay('addOverlay'); renderAll();
        toast(anyTooLarge ? 'Tersimpan, tapi sebagian berkas terlalu besar — hanya pratinjau yang bertahan untuk itu.' : (editingId ? 'Kenangan diperbarui.' : 'Kenangan tersimpan. 🌸'));
      });
    }).finally(function(){ btn.disabled = false; btn.textContent = 'Simpan'; });
  });

  /* ============ GENERIC DELETE ============ */
  document.getElementById('btnConfirmDelete').addEventListener('click', function(){
    if (!pendingDelete) return;
    var d = pendingDelete; pendingDelete = null;
    if (d.type === 'memory'){
      var m = index.find(function(x){return x.id===d.id;});
      index = index.filter(function(x){return x.id!==d.id;});
      saveIndex().then(function(){
        if (m) m.slides.forEach(function(s){ deleteSlideFull(d.id, s.uid); });
        closeOverlay('lbOverlay'); renderAll(); toast('Kenangan dihapus.');
      });
    } else if (d.type === 'song'){
      songs = songs.filter(function(s){return s.id!==d.id;});
      saveSongs().then(function(){ renderSongs(); toast('Lagu dihapus.'); });
    } else if (d.type === 'story'){
      stories = stories.filter(function(s){return s.id!==d.id;});
      saveStories().then(function(){ renderStories(); toast('Cerita dihapus.'); });
    }
    closeOverlay('confirmOverlay');
  });

  /* ============ GENERIC CLOSE ============ */
  Array.prototype.forEach.call(document.querySelectorAll('[data-close]'), function(btn){
    btn.addEventListener('click', function(){ closeOverlay(btn.getAttribute('data-close')); });
  });
  Array.prototype.forEach.call(document.querySelectorAll('.overlay'), function(ov){
    ov.addEventListener('click', function(e){ if (e.target===ov) closeOverlay(ov.id); });
  });

  /* ============ TABS + FILTERS ============ */
  Array.prototype.forEach.call(document.querySelectorAll('nav.tabs button'), function(btn){
    btn.addEventListener('click', function(){
      Array.prototype.forEach.call(document.querySelectorAll('nav.tabs button'), function(b){b.classList.remove('active');});
      btn.classList.add('active');
      currentTab = btn.getAttribute('data-tab');
      document.getElementById('viewGaleri').style.display = currentTab==='galeri' ? '' : 'none';
      document.getElementById('viewFavorit').style.display = currentTab==='favorit' ? '' : 'none';
      document.getElementById('viewWaktu').style.display = currentTab==='waktu' ? '' : 'none';
      document.getElementById('viewKita').style.display = currentTab==='kita' ? '' : 'none';
      document.getElementById('mainToolbar').style.display = currentTab==='kita' ? 'none' : '';
      renderAll();
    });
  });
  document.getElementById('searchInput').addEventListener('input', renderAll);
  document.getElementById('moodFilter').addEventListener('change', renderAll);
  document.getElementById('sortSelect').addEventListener('change', renderAll);

  /* ============ INIT ============ */
  Promise.all([loadIndex(), loadSongs(), loadStories()]).then(function(){
    renderAll();
    document.getElementById('loadingScreen').style.opacity = '0';
    setTimeout(function(){ document.getElementById('loadingScreen').style.display='none'; }, 420);
  });

})();
</script>
</body>
</html>
