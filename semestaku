  function lbShiftMemory(delta){ if (lbList.length<2) return; lbPos = (lbPos + delta + lbList.length) % lbList.length; lbSlideIdx = 0; renderLightbox(); }
  document.getElementById('lbSlidePrev').addEventListener('click', function(){ lbShiftSlide(-1); });
