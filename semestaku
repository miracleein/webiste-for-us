      document.documentElement.style.setProperty('--bg-img', 'none');
      document.body.classList.remove('mem-bg-active');
    }
  }

  /* ============ SONG METADATA FETCHER ============ */
  function fetchSongMetadata(url){
    if (!url || !url.trim()) return Promise.resolve({});
    
    return new Promise(function(resolve){
      var metadata = {};
      
      if (url.indexOf('spotify.com') !== -1){
        metadata.source = 'spotify';
        var trackId = url.match(/track\/([a-zA-Z0-9]+)/);
        if (trackId) metadata.trackId = trackId[1];
      } else if (url.indexOf('youtube.com') !== -1 || url.indexOf('youtu.be') !== -1){
        metadata.source = 'youtube';
        var youtubeId = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/);
        if (youtubeId) metadata.videoId = youtubeId[1];
      } else if (url.indexOf('soundcloud.com') !== -1){
        metadata.source = 'soundcloud';
      } else if (url.indexOf('apple.com/music') !== -1 || url.indexOf('music.apple.com') !== -1){
        metadata.source = 'applemusic';
      }
      
      fetch('https://noembed.com/embed?url=' + encodeURIComponent(url), { mode: 'cors' })
        .then(function(r){ return r.json(); })
        .then(function(data){
          if (data.title) metadata.title = data.title;
          if (data.author_name) metadata.artist = data.author_name;
          if (data.thumbnail_url) metadata.coverImg = data.thumbnail_url;
          resolve(metadata);
        })
        .catch(function(){
          if (url.indexOf('spotify') !== -1){
            metadata.title = 'Spotify Track';
            metadata.coverImg = 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"%3E%3Crect fill="%231DB954" width="100" height="100"/%3E%3Ccircle cx="50" cy="50" r="30" fill="white" opacity="0.3"/%3E%3C/svg%3E';
          } else if (url.indexOf('youtube') !== -1 || url.indexOf('youtu.be') !== -1){
            metadata.title = 'YouTube Video';
            metadata.coverImg = 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"%3E%3Crect fill="%23FF0000" width="100" height="100"/%3E%3Cpolygon points="35,25 35,75 70,50" fill="white"/%3E%3C/svg%3E';
          }
          resolve(metadata);
        });
    });
  }

  /* ============ KITA: songs & stories ============ */
  function getEmbedPlayer(link){
    if (!link) return '';
    if (link.indexOf('youtube.com') !== -1 || link.indexOf('youtu.be') !== -1){
      var videoId = link.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/);
      if (videoId) return '<div class="player-embed"><iframe src="https://www.youtube.com/embed/'+videoId[1]+'?controls=1" allowfullscreen></iframe></div>';
    }
    if (link.indexOf('spotify.com') !== -1){
      var trackId = link.match(/track\/([a-zA-Z0-9]+)/);
      if (trackId) return '<div class="player-embed"><iframe src="https://open.spotify.com/embed/track/'+trackId[1]+'?utm_source=generator" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe></div>';
    }
    if (link.indexOf('soundcloud.com') !== -1){
      return '<div class="player-embed"><iframe width="100%" height="80" scrolling="no" frameborder="no" allow="autoplay" src="https://w.soundcloud.com/player/?url='+encodeURIComponent(link)+'&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true"></iframe></div>';
    }
    return '';
  }
