  /* ============ INTERACTIVE EFFECTS ============ */
  function triggerShake(el){
    if (!el) return;
    el.classList.remove('shake');
    void el.offsetWidth;
    el.classList.add('shake');
    setTimeout(function(){ el.classList.remove('shake'); }, 300);
  }
  
  function createFlowerBurst(e, originEl){
    var petals = ["🌸","🌷","🌺","🌼","💮","🌹"];
    var rect = originEl.getBoundingClientRect();
    var centerX = rect.left + rect.width/2;
    var centerY = rect.top + rect.height/2;
    var clickX = e ? e.clientX : centerX;
    var clickY = e ? e.clientY : centerY;
    
    for (var i = 0; i < 12; i++){
      var petal = document.createElement('div');
      petal.className = 'burst-petal';
      petal.textContent = petals[Math.floor(Math.random() * petals.length)];
      var angle = (i / 12) * Math.PI * 2;
      var dist = 80 + Math.random() * 40;
      var tx = Math.cos(angle) * dist;
      var ty = Math.sin(angle) * dist;
      petal.style.left = clickX + 'px';
      petal.style.top = clickY + 'px';
      petal.style.setProperty('--tx', tx + 'px');
      petal.style.setProperty('--ty', ty + 'px');
      document.body.appendChild(petal);
      setTimeout(function(p){ p.classList.add('burst'); }, 10, petal);
      setTimeout(function(p){ p.remove(); }, 800, petal);
    }
  }
  
  function setMemoryBackground(imgSrc){
    if (imgSrc){
      document.documentElement.style.setProperty('--bg-img', 'url(' + imgSrc + ')');
