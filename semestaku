<script>
(function(){
  "use strict";

  function getStorageApi() {
    if (window.storage && typeof window.storage.get === 'function' && typeof window.storage.set === 'function' && typeof window.storage.delete === 'function') {
      return window.storage;
    }
    return {
      get: function(key){
        try {
          var raw = localStorage.getItem(key);
          return Promise.resolve(raw ? { value: raw } : null);
        } catch (err) {
          return Promise.resolve(null);
        }
      },
      set: function(key, value){
        try {
          localStorage.setItem(key, String(value));
          return Promise.resolve({ ok: true });
        } catch (err) {
          return Promise.reject(err);
        }
      },
      delete: function(key){
        try {
          localStorage.removeItem(key);
          return Promise.resolve({ ok: true });
        } catch (err) {
          return Promise.reject(err);
        }
      }
    };
  }
  window.storage = getStorageApi();

  /* ============ SPLASH SCREEN ============ */
  var SPLASH_PHRASES = ["untuk kamu dan aku","untuk kisah kita","untuk cinta bersama","untuk kisah kita","untuk cerita kita"];
  var splashIdx = 0;
  var splashSubEl = document.getElementById('splashSub');
  function cycleSplashPhrase(){
    splashSubEl.classList.add('out');
    setTimeout(function(){
      splashIdx = (splashIdx+1) % SPLASH_PHRASES.length;
      splashSubEl.textContent = SPLASH_PHRASES[splashIdx];
      splashSubEl.style.transition = 'none';
      splashSubEl.style.transform = 'translateY(18px)';
      void splashSubEl.offsetWidth;
      splashSubEl.style.transition = '';
      splashSubEl.classList.remove('out');
      splashSubEl.style.transform = '';
    }, 480);
  }
  var splashTimer = setInterval(cycleSplashPhrase, 2200);
  setTimeout(function(){ document.getElementById('btnEnter').classList.add('show'); }, 1400);
  document.getElementById('btnEnter').addEventListener('click', function(){
    document.getElementById('splashScreen').classList.add('hide');
    document.body.classList.remove('splash-lock');
    clearInterval(splashTimer);
    setTimeout(function(){ document.getElementById('splashScreen').style.display='none'; }, 700);
  });

  var MAX_SLIDES = 30;
  var MOODS = [
    { id:"bahagia",  em:"🌹", label:"Bahagia" },
    { id:"tenang",   em:"🌿", label:"Tenang" },
    { id:"rindu",    em:"🌺", label:"Rindu" },
    { id:"syukur",   em:"🌻", label:"Bersyukur" },
    { id:"nostalgia",em:"🌸", label:"Nostalgia" },
    { id:"haru",     em:"🌷", label:"Haru" }
  ];
  function moodOf(id){ return MOODS.find(function(m){return m.id===id;}) || MOODS[0]; }
  var PETAL_EMOJI = ["🌸","🌷","🌺","🌼","💮","🌹"];

  var INDEX_KEY = "kenangan_index";
  var SONGS_KEY = "kenangan_songs";
  var STORIES_KEY = "kenangan_stories";

  var index = [];
  var songs = [];
  var stories = [];
  var fullCache = {};
  var currentTab = "galeri";
  var lbList = []; var lbPos = 0; var lbSlideIdx = 0;
  var pendingSlides = []; var removedUids = []; var editingId = null;
  var pendingDelete = null;
  var editingSongId = null;
  var editingStoryId = null;

  function uid(){ return 'm' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }
  function hashRot(id){ var h=0; for (var i=0;i<id.length;i++){ h=(h*31+id.charCodeAt(i))%1000; } return ((h/1000)*8-4).toFixed(2); }
  function fmtDate(iso){
    if(!iso) return "";
    var d = new Date(iso+"T00:00:00");
    if (isNaN(d)) return iso;
    var bulan = ["Jan","Feb","Mar","Apr","Mei","Jun","Jul","Agu","Sep","Okt","Nov","Des"];
    return d.getDate()+" "+bulan[d.getMonth()] + " " + d.getFullYear();
  }
  function monthKey(iso){
    var d = new Date(iso+"T00:00:00");
    var bulanFull = ["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"];
    return bulanFull[d.getMonth()] + " " + d.getFullYear();
  }
  function toast(msg){
    var el = document.createElement('div'); el.className='toast'; el.textContent=msg;
    document.getElementById('toastStack').appendChild(el);
    setTimeout(function(){ el.remove(); }, 2600);
  }
  function openOverlay(id){ document.getElementById(id).classList.add('show'); }
  function closeOverlay(id){ 
    document.getElementById(id).classList.remove('show');
    if (id === 'lbOverlay') {
      setTimeout(function(){ setMemoryBackground(null); }, 300);
    }
  }
  function escapeHtml(s){ return String(s || '').replace(/[&<>\"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

  /* ============ PETALS (background) ============ */
  function spawnPetal(){
    var field = document.getElementById('petal-field');
    var p = document.createElement('div'); p.className='petal';
    p.textContent = PETAL_EMOJI[Math.floor(Math.random()*PETAL_EMOJI.length)];
    var left = Math.random()*100, size = 14+Math.random()*16;
    var fallDur = 9+Math.random()*8, swayDur = 2.5+Math.random()*2.5;
    p.style.left = left+"vw"; p.style.fontSize = size+"px";
    p.style.animationDuration = fallDur+"s, "+swayDur+"s";
    field.appendChild(p);
    p.addEventListener('animationend', function(e){ if (e.animationName==='petal-fall') p.remove(); });
  }
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion){
    for (var i=0;i<5;i++){ setTimeout(spawnPetal, i*400); }
    setInterval(function(){ if (!document.hidden) spawnPetal(); }, 850);
  }

  /* ============ CURSOR FLOWER TRAIL ============ */
  var lastCursorSpawn = 0;
  if (!reduceMotion){
    document.addEventListener('mousemove', function(e){
      var now = Date.now();
      if (now - lastCursorSpawn < 55) return;
      lastCursorSpawn = now;
      var el = document.createElement('div');
      el.className = 'cursor-petal';
      el.textContent = PETAL_EMOJI[Math.floor(Math.random()*PETAL_EMOJI.length)];
      el.style.left = e.clientX+'px'; el.style.top = e.clientY+'px';
      document.body.appendChild(el);
      requestAnimationFrame(function(){ el.classList.add('go'); });
      setTimeout(function(){ el.remove(); }, 900);
    });
  }

  /* ============ STORAGE: memories ============ */
  function loadIndex(){
    return window.storage.get(INDEX_KEY).then(function(res){
      index = res && res.value ? JSON.parse(res.value) : [];
      index.forEach(function(m){ if (!m.slides){ m.slides = [{ uid: m.id+'_s0', type: m.type||'image', thumb: m.thumb }]; } });
    }).catch(function(){ index = []; });
  }
  function saveIndex(){
    return window.storage.set(INDEX_KEY, JSON.stringify(index)).catch(function(err){
      console.error('gagal menyimpan indeks', err); toast('Gagal menyimpan perubahan. Coba lagi.');
    });
  }
  function saveSlideFull(memId, slideUid, payload){
    var str = JSON.stringify(payload);
    if (str.length > 4.4*1024*1024) return Promise.resolve({ok:false, tooLarge:true});
    return window.storage.set('memfull:'+memId+':'+slideUid, str).then(function(){ return {ok:true}; })
      .catch(function(){ return {ok:false, tooLarge:false}; });
  }
  function getSlideFull(memId, slideUid){
    var key = memId+':'+slideUid;
    if (fullCache[key]) return Promise.resolve(fullCache[key]);
    return window.storage.get('memfull:'+key).then(function(res){
      var obj = res && res.value ? JSON.parse(res.value) : null;
      if (obj) fullCache[key] = obj;
      return obj;
    }).catch(function(){ return null; });
  }
  function deleteSlideFull(memId, slideUid){
    delete fullCache[memId+':'+slideUid];
    return window.storage.delete('memfull:'+memId+':'+slideUid).catch(function(){});
  }

  /* ============ STORAGE: songs & stories ============ */
  function loadSongs(){
    return window.storage.get(SONGS_KEY).then(function(res){ songs = res && res.value ? JSON.parse(res.value) : []; }).catch(function(){ songs = []; });
  }
  function saveSongs(){
    return window.storage.set(SONGS_KEY, JSON.stringify(songs)).catch(function(){ toast('Gagal menyimpan lagu.'); });
  }
  function loadStories(){
    return window.storage.get(STORIES_KEY).then(function(res){ stories = res && res.value ? JSON.parse(res.value) : []; }).catch(function(){ stories = []; });
  }
  function saveStories(){
    return window.storage.set(STORIES_KEY, JSON.stringify(stories)).catch(function(){ toast('Gagal menyimpan cerita.'); });
  }

  /* ============ FILE PROCESSING ============ */
  function resizeImage(file, maxDim, quality){
    return new Promise(function(resolve, reject){
      var img = new Image(); var reader = new FileReader();
      reader.onload = function(e){ img.src = e.target.result; };
      reader.onerror = reject;
      img.onload = function(){
        var w=img.width, h=img.height;
        var scale = Math.min(1, maxDim/Math.max(w,h));
        var cw=Math.round(w*scale), ch=Math.round(h*scale);
        var canvas=document.createElement('canvas'); canvas.width=cw; canvas.height=ch;
        canvas.getContext('2d').drawImage(img,0,0,cw,ch);
        resolve(canvas.toDataURL('image/jpeg', quality));
      };
      img.onerror = reject;
      reader.readAsDataURL(file);
    });
  }
  function videoThumbAndData(file){
    return new Promise(function(resolve){
      var video = document.createElement('video'); video.muted = true; video.playsInline = true;
      var url = URL.createObjectURL(file);
      video.src = url;
      var reader = new FileReader(); var dataUrl = null;
      reader.onload = function(e){ dataUrl = e.target.result; };
      reader.readAsDataURL(file);
      video.addEventListener('loadeddata', function(){ try { video.currentTime = Math.min(0.2, (video.duration||1)/4); } catch(e){ draw(); } });
      video.addEventListener('seeked', draw);
      video.addEventListener('error', function(){ finish(null); });
      function draw(){
        try{
          var canvas=document.createElement('canvas');
          var scale=Math.min(1, 300/Math.max(video.videoWidth||300, video.videoHeight||300));
          canvas.width=Math.round((video.videoWidth||300)*scale); canvas.height=Math.round((video.videoHeight||300)*scale);
          canvas.getContext('2d').drawImage(video,0,0,canvas.width,canvas.height);
          URL.revokeObjectURL(url);
          finish(canvas.toDataURL('image/jpeg',0.72));
        }catch(e){ finish(null); }
      }
      function finish(thumb){
        var wait = setInterval(function(){ if (dataUrl){ clearInterval(wait); resolve({ thumb: thumb || dataUrl, dataUrl: dataUrl }); } }, 40);
        setTimeout(function(){ clearInterval(wait); if(dataUrl) resolve({thumb: thumb||dataUrl, dataUrl:dataUrl}); }, 4000);
      }
    });
  }

  function addFilesToPending(fileList){
    var files = Array.prototype.slice.call(fileList);
    var room = MAX_SLIDES - pendingSlides.length;
    if (room <= 0){ toast('Sudah mencapai batas 30 slide untuk satu kenangan.'); return; }
    if (files.length > room){ toast('Hanya '+room+' file ditambahkan (batas 30 slide per kenangan).'); files = files.slice(0, room); }
    files.forEach(function(file){
      var placeholderUid = uid();
      pendingSlides.push({ uid: placeholderUid, type: file.type.indexOf('video')===0?'video':'image', thumb:null, dataUrl:null, isNew:true, processing:true });
      renderSlideGrid();
      var isVideo = file.type.indexOf('video') === 0;
      var job = isVideo ? videoThumbAndData(file) : Promise.all([resizeImage(file,1500,0.84), resizeImage(file,300,0.7)]).then(function(r){ return {dataUrl:r[0], thumb:r[1]}; });
      job.then(function(res){
        var slot = pendingSlides.find(function(s){return s.uid===placeholderUid;});
        if (!slot) return;
        slot.thumb = res.thumb; slot.dataUrl = res.dataUrl; slot.processing = false;
        renderSlideGrid();
      }).catch(function(){
        pendingSlides = pendingSlides.filter(function(s){return s.uid!==placeholderUid;});
        toast('Gagal memproses salah satu file.'); renderSlideGrid();
      });
    });
  }

  function renderSlideGrid(){
    var grid = document.getElementById('slideGrid');
    var count = document.getElementById('slideCount');
    count.textContent = pendingSlides.length ? (pendingSlides.length + ' dari '+MAX_SLIDES+' slide') : '';
    grid.innerHTML = pendingSlides.map(function(s){
      if (s.processing){ return '<div class="slide-thumb processing">⏳</div>'; }
      return '<div class="slide-thumb" data-uid="'+s.uid+'"><img src="'+s.thumb+'" alt="">'+
        (s.type==='video' ? '<span class="vtag">▶</span>' : '')+
        '<button class="rm" data-rm="'+s.uid+'" type="button">✕</button></div>';
    }).join('');
    Array.prototype.forEach.call(grid.querySelectorAll('[data-rm]'), function(btn){
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        var u = btn.getAttribute('data-rm');
        var slide = pendingSlides.find(function(s){return s.uid===u;});
        if (slide && !slide.isNew){ removedUids.push(u); }
        pendingSlides = pendingSlides.filter(function(s){return s.uid!==u;});
        renderSlideGrid();
      });
    });
  }

  /* ============ STATS ============ */
  function renderStats(){
    var box = document.getElementById('statRow');
    if (!index.length){ box.innerHTML=''; return; }
    var favCount = index.filter(function(m){return m.favorite;}).length;
    var totalSlides = index.reduce(function(a,m){return a+(m.slides?m.slides.length:1);},0);
    var sorted = index.slice().sort(function(a,b){return a.date.localeCompare(b.date);});
    var first = sorted[0];
    box.innerHTML =
      '<span><b>'+index.length+'</b> kenangan</span>'+
      '<span><b>'+totalSlides+'</b> slide tersimpan</span>'+
      '<span><b>'+favCount+'</b> favorit</span>'+
      (first ? '<span>sejak <b>'+fmtDate(first.date)+'</b></span>' : '');
  }

  /* ============ FILTER / SORT ============ */
  function getFiltered(){
    var q = document.getElementById('searchInput').value.trim().toLowerCase();
    var moodF = document.getElementById('moodFilter').value;
    var sortV = document.getElementById('sortSelect').value;
    var list = index.filter(function(m){
